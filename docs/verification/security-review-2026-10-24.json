{
  "date": "2026-10-24",
  "scope": "Synthetic localhost authorization probes and public HTTPS GET headers; no production authentication or mutation",
  "password_probe": {
    "password_algorithm": "bcrypt",
    "different_password_same_first_72_bytes_accepted": true,
    "fixtures": "created",
    "private_material_printed": false
  },
  "local": [
    {
      "test": "Anonymous browser session",
      "authenticated": false,
      "http": 200
    },
    {
      "test": "Read-only key via v2 mutation",
      "http": 403,
      "error_code": "scope"
    },
    {
      "test": "Same read-only key via HTML manage product.create",
      "http": 303,
      "redirect_to_created_product": true
    },
    {
      "test": "Synthetic unauthorized product persisted",
      "http": 200,
      "created": true
    },
    {
      "test": "Same read-only key via HTML manage label.publish",
      "http": 303,
      "redirect_present": true
    },
    {
      "test": "Synthetic label became public after read-only key",
      "http": 200
    },
    {
      "test": "Read-only key can use HTML export without export scope",
      "http": 200,
      "transfer_schema": "openaliment.transfer.v1"
    }
  ],
  "production": [
