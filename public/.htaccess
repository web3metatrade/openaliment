Options -Indexes -MultiViews
DirectoryIndex index.php
<IfModule mod_mime.c>
 AddType application/wasm .wasm
 AddType application/gzip .gz
</IfModule>
Require all granted
RewriteEngine On
RewriteCond %{HTTPS} =on
RewriteRule ^ - [E=OA_HTTPS:1]
RewriteRule ^assets/.*\.(php[0-9]*|phtml|phar)(/.*)?$ - [F,L,NC]
RewriteCond %{HTTP_HOST} ^www\.openaliment\.ro$ [NC]
RewriteRule ^ https://openaliment.ro%{REQUEST_URI} [R=308,L,NE]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} ^dev\.openaliment\.ro$ [NC]
RewriteRule ^ https://dev.openaliment.ro%{REQUEST_URI} [R=308,L,NE]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
RewriteRule ^ https://openaliment.ro%{REQUEST_URI} [R=308,L,NE]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
<FilesMatch "(?i)(^\.|(?:\.(?:env|sql|log|bak|ini|dist|old|orig|zip|7z|tar)(?:\.(?:gz|zip))?|~)$)">
 Require all denied
</FilesMatch>
<IfModule mod_headers.c>
 <IfModule mod_setenvif.c>
  SetEnvIfNoCase Host "^dev\.openaliment\.ro(?::443)?$" OA_STAGING=1
  Header always set X-Robots-Tag "noindex, nofollow, noarchive" env=OA_STAGING
 </IfModule>
 Header unset X-Powered-By
 Header always unset X-Powered-By
 Header always set X-Content-Type-Options nosniff
 Header onsuccess unset Strict-Transport-Security
 Header always set Strict-Transport-Security "max-age=86400" env=OA_HTTPS
 <FilesMatch "\.(css|js|svg|png|jpg|webp)$">
  Header set Cache-Control "public, max-age=604800"
  Header set X-Content-Type-Options nosniff
 </FilesMatch>
 <FilesMatch "\.(wasm|traineddata\.gz)$">
  Header set Cache-Control "public, max-age=604800"
  Header set X-Content-Type-Options nosniff
 </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
 AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “alt-php84” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-alt-php84 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
