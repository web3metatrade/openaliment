        {
          "type": "null"
        }
      ]
    },
    "name_language": {
      "type": "string",
      "maxLength": 3
    },
    "brand": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 500
        },
        {
          "type": "null"
        }
      ]
    },
    "net_quantity": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 100
        },
        {
          "type": "null"
