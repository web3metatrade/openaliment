                  "fat_g": {
                    "type": "string",
                    "maxLength": 10
                  },
                  "saturates_g": {
                    "type": "string",
                    "maxLength": 10
                  },
                  "carbohydrate_g": {
                    "type": "string",
                    "maxLength": 10
                  },
                  "sugars_g": {
                    "type": "string",
                    "maxLength": 10
                  },
                  "polyols_g": {
                    "type": "string",
                    "maxLength": 10
                  },
                  "fibre_g": {
                    "type": "string",
                    "maxLength": 10
                  },
                  "protein_g": {
                    "type": "string",
                    "maxLength": 10
                  },
                  "salt_g": {
                    "type": "string",
                    "maxLength": 10
