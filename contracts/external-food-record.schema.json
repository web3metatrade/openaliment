      "const": "openaliment.external-food.v1"
    },
    "provider": {
      "const": "openfoodfacts"
    },
    "gtin14": {
      "type": "string",
      "pattern": "^[0-9]{14}$"
    },
    "source_code": {
      "type": "string",
      "pattern": "^(?:[0-9]{8}|[0-9]{12}|[0-9]{13}|[0-9]{14})$"
    },
    "name": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 180
