          "enum": [
            "reported",
            "derived",
            "unknown"
          ]
        },
        "contains": {
          "type": "array",
          "maxItems": 14,
          "items": {
            "enum": [
              "gluten",
              "crustaceans",
              "eggs",
              "fish",
              "peanuts",
              "soy",
              "milk",
              "nuts",
              "celery",
              "mustard",
              "sesame",
              "sulphites",
              "lupin",
              "molluscs"
