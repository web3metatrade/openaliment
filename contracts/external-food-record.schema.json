            "enum": [
              "gluten",
              "crustaceans",
              "eggs",
              "fish",
              "peanuts",
              "soy",
              "milk",
              "nuts",
              "celery",
              "mustard",
              "sesame",
              "sulphites",
              "lupin",
              "molluscs"
