{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenAliment — conectoare pentru parteneri și bonuri digitale",
    "version": "2.1.0",
    "description": "Mapări declarative versionate pentru produse, loturi și bonuri digitale. Importul catalogului creează ciorne; publicarea, drepturile GS1 și licențierea se aprobă separat. API v1 rămâne compatibil."
  },
  "servers": [
    {
      "url": "https://openaliment.ro"
    }
  ],
  "components": {
    "securitySchemes": {
      "producerToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Producer token with read/write scope; approval uses separate v1 publish routes."
      }
    },
    "schemas": {
      "Mapping": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "OpenAliment declarative partner mapping v1",
        "type": "object",
        "required": [
          "schema_version",
          "fields"
        ],
        "properties": {
          "schema_version": {
            "const": "openaliment.mapping.v1"
          },
          "fields": {
            "type": "object",
            "maxProperties": 100,
            "propertyNames": {
              "pattern": "^/",
              "maxLength": 240
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "from": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "value": {},
                "op": {
                  "enum": [
                    "copy",
                    "text",
                    "decimal",
                    "integer",
                    "gtin",
                    "date_iso",
                    "date_dmy",
                    "boolean"
                  ]
                },
                "required": {
                  "type": "boolean"
                }
              },
              "oneOf": [
                {
                  "required": [
                    "from"
                  ],
                  "not": {
                    "required": [
                      "value"
                    ]
                  }
                },
                {
                  "required": [
                    "value"
                  ],
                  "not": {
                    "required": [
                      "from"
                    ]
                  }
                }
              ],
              "additionalProperties": false
            }
          },
          "arrays": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "type": "object",
              "required": [
                "from",
                "to",
                "fields"
              ],
              "properties": {
                "from": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "to": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "fields": {
                  "type": "object",
                  "maxProperties": 100,
                  "propertyNames": {
                    "pattern": "^/",
                    "maxLength": 240
                  },
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "from": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 240
                      },
                      "value": {},
                      "op": {
                        "enum": [
                          "copy",
                          "text",
                          "decimal",
                          "integer",
                          "gtin",
                          "date_iso",
                          "date_dmy",
                          "boolean"
                        ]
                      },
                      "required": {
                        "type": "boolean"
                      }
                    },
                    "oneOf": [
                      {
                        "required": [
                          "from"
                        ],
                        "not": {
                          "required": [
                            "value"
                          ]
                        }
                      },
                      {
                        "required": [
                          "value"
                        ],
                        "not": {
                          "required": [
                            "from"
                          ]
                        }
                      }
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "Event": {
        "type": "object",
        "required": [
          "mapping_id",
          "operation",
          "payload"
        ],
        "properties": {
          "mapping_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "operation": {
            "enum": [
              "product",
              "batch",
              "receipt"
            ]
          },
          "payload": {
            "type": "object"
          },
          "event_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "external_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "additionalProperties": false
      },
      "Receipt": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "title": "OpenAliment private digital receipt v1",
        "type": "object",
        "required": [
          "schema_version",
          "id",
          "merchant",
          "receipt_external_id",
          "issued_at",
          "lines",
          "simulation"
        ],
        "properties": {
          "schema_version": {
            "const": "openaliment.receipt.v1"
          },
          "id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "merchant": {
            "type": "string",
            "minLength": 1,
            "maxLength": 180
          },
          "receipt_external_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "issued_at": {
            "type": "string",
            "format": "date-time"
          },
          "simulation": {
            "type": "boolean"
          },
          "lines": {
            "type": "array",
            "minItems": 1,
            "maxItems": 500,
            "items": {
              "type": "object",
              "required": [
                "line_id",
                "name",
                "gtin14",
                "lot_code",
                "quantity",
                "unit",
                "expiry"
              ],
              "properties": {
                "line_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 180
                },
                "gtin14": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[0-9]{14}$"
                },
                "lot_code": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 120
                },
                "quantity": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 100000
                },
                "unit": {
                  "enum": [
                    "pack",
                    "g",
                    "ml"
                  ]
                },
                "expiry": {
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "$ref": "/api/schemas/food-date.schema.json"
                    }
                  ]
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "security": [
    {
      "Bearer": []
    }
  ],
