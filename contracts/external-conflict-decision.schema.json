{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "state": {
      "enum": [
        "accepted",
        "rejected",
        "different_market"
      ]
    },
    "reason": {
      "type": "string",
      "maxLength": 1500
    },
    "version_key": {
      "type": "string",
      "maxLength": 60
    },
    "fields": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "enum": [
          "name",
          "ingredients",
          "allergens",
          "net_quantity",
          "storage",
          "nutrition"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "completion": {
      "type": "object",
      "properties": {
        "category": {
          "type": "string",
          "maxLength": 1500
        },
        "operator": {
          "type": "string",
          "maxLength": 1500
        },
        "ingredients": {
          "type": "string",
          "maxLength": 5000
        },
        "allergens": {
          "type": "string",
          "maxLength": 1500
        },
        "net_quantity": {
          "type": "string",
          "maxLength": 1500
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "state",
    "reason"
  ],
  "additionalProperties": false
}
